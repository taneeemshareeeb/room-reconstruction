{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://room-reconstruction.local/schemas/plan-0.6.0.json",
  "title": "Room reconstruction result",
  "description": "Versioned result contract. Unavailable measurements are represented explicitly, never guessed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "created_at", "capture", "processing", "rooms", "wall_candidates", "cross_height_wall_candidates", "room_candidates", "opening_candidates", "wall_gap_candidates", "wall_room_candidates", "floor_height_candidate", "ceiling_height_candidates", "ground_truth_comparison", "room_connections", "scope_line_items", "capabilities", "artifacts", "limitations"],
  "properties": {
    "schema_version": {"const": "0.6.0"},
    "status": {"enum": ["partial", "complete", "failed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "capture": {
      "type": "object", "additionalProperties": false, "required": ["id", "tier"],
      "properties": {"id": {"type": "string", "minLength": 1}, "tier": {"enum": ["photos", "video", "lidar"]}}
    },
    "processing": {
      "type": "object", "additionalProperties": false, "required": ["frame_step", "voxel_size_m", "point_count", "pass_split"],
      "properties": {
        "frame_step": {"type": "integer", "minimum": 1},
        "voxel_size_m": {"type": "number", "exclusiveMinimum": 0},
        "point_count": {"type": "integer", "minimum": 0},
        "pass_split": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/pass_split"}]}
      }
    },
    "rooms": {"type": "array", "items": {"$ref": "#/$defs/room"}},
    "wall_candidates": {"type": "array", "items": {"$ref": "#/$defs/wall_candidate"}},
    "cross_height_wall_candidates": {"type": "array", "items": {"$ref": "#/$defs/wall_consensus_candidate"}},
    "room_candidates": {"type": "array", "items": {"$ref": "#/$defs/room_candidate"}},
    "opening_candidates": {"type": "array", "items": {"$ref": "#/$defs/opening_candidate"}},
    "wall_gap_candidates": {"type": "array", "items": {"$ref": "#/$defs/wall_gap_candidate"}},
    "wall_room_candidates": {"type": "array", "items": {"$ref": "#/$defs/wall_room_candidate"}},
    "floor_height_candidate": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/floor_height_candidate"}]},
    "ceiling_height_candidates": {"type": "array", "items": {"$ref": "#/$defs/ceiling_height_candidate"}},
    "ground_truth_comparison": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ground_truth_comparison"}]},
    "room_connections": {"type": "array", "items": {"$ref": "#/$defs/room_connection"}},
    "scope_line_items": {"type": "array", "items": {"$ref": "#/$defs/scope_item"}},
    "capabilities": {"type": "object", "additionalProperties": {"enum": ["available", "candidate_available", "not_implemented", "insufficient_data"]}},
    "artifacts": {"type": "object", "additionalProperties": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "pass_split": {
      "type": "object", "additionalProperties": false,
      "required": ["split_row_index", "frame_count", "elapsed_time_s", "pass_a_view_y_mean", "pass_b_view_y_mean", "smoothing_window_frames"],
      "properties": {
        "split_row_index": {"type": "integer", "minimum": 1},
        "frame_count": {"type": "integer", "minimum": 2},
        "elapsed_time_s": {"type": "number", "minimum": 0},
        "pass_a_view_y_mean": {"type": "number", "maximum": -0.1},
        "pass_b_view_y_mean": {"type": "number", "minimum": 0.1},
        "smoothing_window_frames": {"type": "integer", "minimum": 1}
      }
    },
    "floor_height_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["elevation_world_y_m", "observed_half_width_m", "supporting_points_in_0_24m_band", "reference_pass", "status", "reason"],
      "properties": {
        "elevation_world_y_m": {"type": "number"},
        "observed_half_width_m": {"type": ["number", "null"], "minimum": 0},
        "supporting_points_in_0_24m_band": {"type": "integer", "minimum": 0},
        "reference_pass": {"enum": ["A", "unsegmented"]},
        "status": {"const": "candidate_unverified"},
        "reason": {"type": "string"}
      }
    },
    "ceiling_height_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "elevation_world_y_m", "height_above_floor_m", "observed_half_width_m", "peak_supporting_points", "fraction_of_upper_pass_slice", "reference_pass", "status", "reason"],
      "properties": {
        "id": {"type": "string"},
        "elevation_world_y_m": {"type": "number"},
        "height_above_floor_m": {"type": "number"},
        "observed_half_width_m": {"type": "number", "minimum": 0},
        "peak_supporting_points": {"type": "integer", "minimum": 0},
        "fraction_of_upper_pass_slice": {"type": "number", "minimum": 0, "maximum": 1},
        "reference_pass": {"const": "B"},
        "status": {"const": "candidate_unverified"},
        "reason": {"type": "string"}
      }
    },
    "ground_truth_comparison": {
      "type": "object", "additionalProperties": true,
      "required": ["status", "ground_truth_source", "spatial_registration", "measured_side_comparisons", "closest_candidate_for_each_measured_side", "room_candidate_ranking_by_two_widths", "doorway_comparison", "ceiling_height_comparison", "limitations"],
      "properties": {
        "status": {"const": "partial_unregistered_comparison"},
        "ground_truth_source": {"type": "string"},
        "spatial_registration": {"const": "not_available"},
        "measured_side_comparisons": {"type": "array"},
        "closest_candidate_for_each_measured_side": {"type": "array"},
        "room_candidate_ranking_by_two_widths": {"type": "array"},
        "doorway_comparison": {"oneOf": [{"type": "null"}, {"type": "object"}]},
        "ceiling_height_comparison": {"type": "object"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "room_geometry_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["polygon_area_m2", "polygon_perimeter_m", "dominant_axis_spans_m", "dominant_axis_rotation_deg", "status", "reason"],
      "properties": {
        "polygon_area_m2": {"type": "number", "minimum": 0},
        "polygon_perimeter_m": {"type": "number", "minimum": 0},
        "dominant_axis_spans_m": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 2, "maxItems": 2},
        "dominant_axis_rotation_deg": {"type": "number"},
        "status": {"const": "candidate_unverified"},
        "reason": {"type": "string"}
      }
    },
    "room_floor_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["elevation_world_y_m", "height_above_global_floor_m", "supporting_points", "observed_p05_p95_span_m", "status", "reason"],
      "properties": {
        "elevation_world_y_m": {"type": ["number", "null"]},
        "height_above_global_floor_m": {"type": ["number", "null"]},
        "supporting_points": {"type": "integer", "minimum": 0},
        "observed_p05_p95_span_m": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}]},
        "status": {"enum": ["candidate_unverified", "insufficient_data"]},
        "reason": {"type": "string"}
      }
    },
    "room_upper_candidates": {
      "type": "object", "additionalProperties": false,
      "required": ["supporting_points_in_height_range", "height_candidates", "status"],
      "properties": {
        "supporting_points_in_height_range": {"type": "integer", "minimum": 0},
        "height_candidates": {"type": "array", "items": {"$ref": "#/$defs/room_upper_peak"}},
        "status": {"enum": ["candidate_available", "insufficient_data"]}
      }
    },
    "room_upper_peak": {
      "type": "object", "additionalProperties": false,
      "required": ["elevation_world_y_m", "height_above_local_floor_m", "supporting_points", "observed_half_width_m", "status", "reason"],
      "properties": {
        "elevation_world_y_m": {"type": "number"},
        "height_above_local_floor_m": {"type": "number"},
        "supporting_points": {"type": "integer", "minimum": 0},
        "observed_half_width_m": {"type": "number", "minimum": 0},
        "status": {"const": "candidate_unverified"},
        "reason": {"type": "string"}
      }
    },
    "room_wall_link": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_candidate_id", "length_m", "boundary_distance_m", "supporting_height_bands", "status"],
      "properties": {
        "wall_candidate_id": {"type": "string"},
        "length_m": {"type": "number", "exclusiveMinimum": 0},
        "boundary_distance_m": {"type": "number", "minimum": 0},
        "supporting_height_bands": {"type": "array", "items": {"enum": ["lower", "current", "upper"]}},
        "status": {"const": "unverified_spatial_association"}
      }
    },
    "room_gap_link": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_gap_candidate_id", "observed_width_m", "boundary_distance_m", "status"],
      "properties": {
        "wall_gap_candidate_id": {"type": "string"},
        "observed_width_m": {"type": "number", "exclusiveMinimum": 0},
        "boundary_distance_m": {"type": "number", "minimum": 0},
        "status": {"const": "unverified_spatial_association"}
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "interval", "status", "reason"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "unit": {"type": "string"},
        "interval": {"oneOf": [{"type": "null"}, {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}], "default": null},
        "status": {"enum": ["estimated", "insufficient_data", "not_observed", "not_implemented"]},
        "reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "estimated"}}, "required": ["status"]}, "then": {"properties": {"value": {"type": "number"}, "interval": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}}}},
        {"if": {"properties": {"status": {"enum": ["insufficient_data", "not_observed", "not_implemented"]}}, "required": ["status"]}, "then": {"properties": {"value": {"type": "null"}, "interval": {"type": "null"}, "reason": {"type": "string", "minLength": 1}}}}
      ]
    },
    "point2d": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "wall_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "start_xz_m", "end_xz_m", "length_m", "supporting_cells", "height_band_support_count", "supporting_height_bands", "cross_height_consensus_ids", "support_status", "status", "reason"],
      "properties": {
        "id": {"type": "string"},
        "start_xz_m": {"$ref": "#/$defs/point2d"},
        "end_xz_m": {"$ref": "#/$defs/point2d"},
        "length_m": {"type": "number", "exclusiveMinimum": 0},
        "supporting_cells": {"type": "integer", "minimum": 1},
        "height_band_support_count": {"type": "integer", "minimum": 1, "maximum": 3},
        "supporting_height_bands": {"type": "array", "items": {"enum": ["lower", "current", "upper"]}, "minItems": 1, "uniqueItems": true},
        "cross_height_consensus_ids": {"type": "array", "items": {"type": "string", "pattern": "^wall_consensus_[0-9]{2}$"}, "uniqueItems": true},
        "support_status": {"const": "unverified_consistency_hint"},
        "status": {"const": "candidate_unverified"},
        "reason": {"type": "string"}
      }
    },
    "wall_consensus_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "start_xz_m", "end_xz_m", "shared_length_m", "supporting_bands", "support_count", "source_candidates", "status", "reason"],
      "properties": {
        "id": {"type": "string"},
        "start_xz_m": {"$ref": "#/$defs/point2d"},
        "end_xz_m": {"$ref": "#/$defs/point2d"},
        "shared_length_m": {"type": "number", "exclusiveMinimum": 0},
        "supporting_bands": {"type": "array", "items": {"enum": ["lower", "current", "upper"]}, "minItems": 2, "maxItems": 3, "uniqueItems": true},
        "support_count": {"type": "integer", "minimum": 2, "maximum": 3},
        "source_candidates": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["band", "id"],
            "properties": {
              "band": {"enum": ["lower", "current", "upper"]},
              "id": {"type": "string"}
            }
          }
        },
        "status": {"const": "candidate_unverified"},
        "reason": {"type": "string"}
      }
    },
    "room_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "estimated_area_m2", "bounds_xz_m", "center_xz_m", "boundary_xz_m", "status", "reason"],
      "properties": {
        "id": {"type": "string"},
        "estimated_area_m2": {"type": "number", "exclusiveMinimum": 0},
        "bounds_xz_m": {"type": "array", "prefixItems": [{"$ref": "#/$defs/point2d"}, {"$ref": "#/$defs/point2d"}], "minItems": 2, "maxItems": 2},
        "center_xz_m": {"$ref": "#/$defs/point2d"},
        "boundary_xz_m": {"type": "array", "items": {"$ref": "#/$defs/point2d"}, "minItems": 4},
        "status": {"const": "candidate_unverified"},
        "reason": {"type": "string"},
        "geometry_candidate": {"$ref": "#/$defs/room_geometry_candidate"},
        "floor_surface_candidate": {"$ref": "#/$defs/room_floor_candidate"},
        "upper_surface_candidates": {"$ref": "#/$defs/room_upper_candidates"},
        "nearby_wall_evidence": {"type": "array", "items": {"$ref": "#/$defs/room_wall_link"}},
        "nearby_wall_gap_evidence": {"type": "array", "items": {"$ref": "#/$defs/room_gap_link"}}
      }
    },
    "opening_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "room_ids", "center_xz_m", "gap_endpoints_xz_m", "observed_gap_m", "status", "reason"],
      "properties": {
        "id": {"type": "string"},
        "room_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
        "center_xz_m": {"$ref": "#/$defs/point2d"},
        "gap_endpoints_xz_m": {"type": "array", "prefixItems": [{"$ref": "#/$defs/point2d"}, {"$ref": "#/$defs/point2d"}], "minItems": 2, "maxItems": 2},
        "observed_gap_m": {"type": "number", "exclusiveMinimum": 0},
        "status": {"const": "candidate_unverified"},
        "reason": {"type": "string"}
      }
    },
    "wall_gap_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "wall_candidate_ids", "center_xz_m", "gap_endpoints_xz_m", "observed_gap_m", "supporting_height_bands", "height_band_support_count", "status", "reason"],
      "properties": {
        "id": {"type": "string"},
        "wall_candidate_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
        "center_xz_m": {"$ref": "#/$defs/point2d"},
        "gap_endpoints_xz_m": {"type": "array", "prefixItems": [{"$ref": "#/$defs/point2d"}, {"$ref": "#/$defs/point2d"}], "minItems": 2, "maxItems": 2},
        "observed_gap_m": {"type": "number", "exclusiveMinimum": 0},
        "supporting_height_bands": {"type": "array", "items": {"enum": ["lower", "current", "upper"]}, "uniqueItems": true},
        "height_band_support_count": {"type": "integer", "minimum": 1, "maximum": 3},
        "status": {"const": "candidate_unverified"},
        "reason": {"type": "string"}
      }
    },
    "wall_room_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "boundary_xz_m", "side_lengths_m", "corner_angles_deg", "estimated_area_m2", "side_support_fraction", "minimum_side_support_fraction", "source_wall_ids", "status", "reason"],
      "properties": {
        "id": {"type": "string"},
        "boundary_xz_m": {"type": "array", "items": {"$ref": "#/$defs/point2d"}, "minItems": 4, "maxItems": 4},
        "side_lengths_m": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 4, "maxItems": 4},
        "corner_angles_deg": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 180}, "minItems": 4, "maxItems": 4},
        "estimated_area_m2": {"type": "number", "exclusiveMinimum": 0},
        "side_support_fraction": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 4, "maxItems": 4},
        "minimum_side_support_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "source_wall_ids": {"type": "array", "items": {"type": "string"}, "minItems": 4, "maxItems": 4, "uniqueItems": true},
        "status": {"const": "candidate_unverified"},
        "reason": {"type": "string"}
      }
    },
    "room_connection": {
      "type": "object", "additionalProperties": false,
      "required": ["room_ids", "opening_candidate_id"],
      "properties": {
        "room_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
        "opening_candidate_id": {"type": "string"}
      }
    },
    "room": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "floor_polygon_m", "floor_area_m2", "ceiling_height_m", "walls", "openings", "adjacent_room_ids", "damage_regions", "concealed_damage"],
      "properties": {
        "id": {"type": "string"},
        "floor_polygon_m": {"type": "array", "items": {"$ref": "#/$defs/point2d"}},
        "floor_area_m2": {"$ref": "#/$defs/measurement"},
        "ceiling_height_m": {"$ref": "#/$defs/measurement"},
        "walls": {"type": "array", "items": {"type": "object", "required": ["id", "length_m"], "properties": {"id": {"type": "string"}, "length_m": {"$ref": "#/$defs/measurement"}}}},
        "openings": {"type": "array", "items": {"type": "object", "required": ["type", "width_m", "height_m", "sill_height_m"], "properties": {"type": {"enum": ["door", "window", "unknown"]}, "width_m": {"$ref": "#/$defs/measurement"}, "height_m": {"$ref": "#/$defs/measurement"}, "sill_height_m": {"$ref": "#/$defs/measurement"}}}},
        "adjacent_room_ids": {"type": "array", "items": {"type": "string"}},
        "damage_regions": {"type": "array", "items": {"type": "object", "required": ["type", "area_m2", "confidence"], "properties": {"type": {"type": "string"}, "area_m2": {"$ref": "#/$defs/measurement"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
        "concealed_damage": {"type": "array", "items": {"type": "object", "required": ["type", "status", "reason"], "properties": {"type": {"type": "string"}, "status": {"enum": ["suspected", "not_observed", "not_assessed"]}, "reason": {"type": "string"}}}}
      }
    },
    "scope_item": {
      "type": "object", "additionalProperties": false, "required": ["room_id", "trade", "description", "quantity"],
      "properties": {"room_id": {"type": ["string", "null"]}, "trade": {"type": "string"}, "description": {"type": "string"}, "quantity": {"$ref": "#/$defs/measurement"}}
    }
  }
}
